10 REM ===================================================
20 REM APOLLO LUNAR LANDER - 1969 RETRO PHYSICS SIMULATION
30 REM FOR CP/M MBASIC ON RUNCPM / RV32IM RETRO CONSOLE
40 REM ===================================================
50 PRINT "=============================================="
60 PRINT "      APOLLO 11 LUNAR LANDING SIMULATOR       "
70 PRINT "=============================================="
80 PRINT "YOU ARE IN THE LUNAR MODULE 'EAGLE'."
90 PRINT "LUNAR GRAVITY IS 5.3 FT/SEC^2."
100 PRINT "RADAR BEACON LOCK ACQUIRED AT 1,000 FEET."
110 PRINT "MAXIMUM SAFE TOUCHDOWN SPEED IS 5.0 FT/SEC."
120 PRINT "==============================================": PRINT
130 ALT = 1000: VEL = 50: FUEL = 500: T = 0
200 REM --- SIMULATION TICK LOOP ---
210 PRINT "TIME: "; T; " SEC | ALT: "; INT(ALT); " FT | VEL: "; INT(VEL); " FT/S | FUEL: "; INT(FUEL); " LBS"
220 IF ALT <= 0 GOTO 500
230 INPUT "RETRO-ROCKET BURN (0-30 LBS)"; BURN
240 IF BURN < 0 THEN BURN = 0
250 IF BURN > 30 THEN BURN = 30
260 IF BURN > FUEL THEN BURN = FUEL: PRINT "*** FUEL EXHAUSTED! FREE FALL! ***"
270 FUEL = FUEL - BURN
280 ACC = 5.3 - (BURN * 0.4)
290 VEL = VEL + ACC
300 ALT = ALT - VEL
310 T = T + 1
320 GOTO 210
500 REM --- TOUCHDOWN RATING ---
510 PRINT: PRINT "================ TOUCHDOWN! ================"
520 PRINT "TIME OF DESCENT: "; T; " SECONDS."
530 PRINT "IMPACT VELOCITY: "; ABS(INT(VEL)); " FT/SEC."
540 IF ABS(VEL) <= 2 THEN PRINT "PERFECT TOUCHDOWN! THE EAGLE HAS LANDED IN THE SEA OF TRANQUILITY!": GOTO 600
550 IF ABS(VEL) <= 5 THEN PRINT "GOOD LANDING! MINOR GEAR DAMAGE, CREW SAFE!": GOTO 600
560 IF ABS(VEL) <= 15 THEN PRINT "HARD IMPACT! ENGINE CRUSHED, CREW STRANDED ON MOON!": GOTO 600
570 PRINT "CATASTROPHIC COLLISION! CRATER FORMED, CREW PERISHED.": GOTO 600
600 PRINT "============================================": END
