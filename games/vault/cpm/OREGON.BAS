10 REM ===================================================
20 REM THE OREGON TRAIL - 1975 CLASSIC PIONEER EXPEDITION
30 REM FOR CP/M MBASIC ON RUNCPM / RV32IM RETRO CONSOLE
40 REM ===================================================
50 PRINT "=================================================="
60 PRINT "          *** THE OREGON TRAIL (1975) ***         "
70 PRINT "=================================================="
80 PRINT "YOU ARE TRAVELING 2,040 MILES FROM MISSOURI TO OREGON!"
90 PRINT "==================================================": PRINT
100 DIST = 0: FOOD = 500: BULLETS = 50: HEALTH = 100: DAY = 1
200 REM --- EXPEDITION DAY TICK ---
210 PRINT "DAY "; DAY; " | MILES: "; DIST; " / 2040 | FOOD: "; FOOD; " LBS | HEALTH: "; HEALTH; "%"
220 IF DIST >= 2040 GOTO 800
230 IF HEALTH <= 0 OR FOOD <= 0 GOTO 900
240 PRINT "CHOOSE ACTION: 1=TRAVEL, 2=HUNT, 3=REST, 4=RESIGN"
250 INPUT "ACTION"; ACT
260 IF ACT = 1 GOTO 300
270 IF ACT = 2 GOTO 400
280 IF ACT = 3 GOTO 500
290 IF ACT = 4 GOTO 950
295 PRINT "INVALID CHOICE!": GOTO 240
300 REM --- TRAVEL ---
310 M = INT(RND(1)*40) + 50
320 DIST = DIST + M: FOOD = FOOD - 25: DAY = DAY + 1
330 PRINT "TRAVEL ADVANCE: YOU COVERED "; M; " MILES TODAY."
340 IF RND(1) < 0.2 THEN PRINT "*** HEAVY RAIN! TRAIL IS MUDDY! ***": HEALTH = HEALTH - 5
350 IF RND(1) < 0.15 THEN PRINT "*** OXEN EXHAUSTION! LOST 1 DAY! ***": DAY = DAY + 1
360 GOTO 200
400 REM --- HUNT ---
410 IF BULLETS < 10 THEN PRINT "NOT ENOUGH BULLETS TO HUNT!": GOTO 240
420 BULLETS = BULLETS - 10: MEAT = INT(RND(1)*80) + 40
430 FOOD = FOOD + MEAT: DAY = DAY + 1
440 PRINT "*** HUNTING SUCCESS! BAGGED "; MEAT; " LBS OF GAME! ***"
450 GOTO 200
500 REM --- REST ---
510 HEALTH = HEALTH + 15: IF HEALTH > 100 THEN HEALTH = 100
520 FOOD = FOOD - 15: DAY = DAY + 1
530 PRINT "CREW RESTED. HEALTH RESTORED TO "; HEALTH; "%."
540 GOTO 200
800 PRINT "=================================================="
810 PRINT "*** CONGRATULATIONS! YOU REACHED OREGON CITY! ***"
820 PRINT "YOU COMPLETED THE TRAIL IN "; DAY; " DAYS!"
830 PRINT "FINAL FOOD: "; FOOD; " LBS | HEALTH: "; HEALTH; "%"
840 PRINT "==================================================": END
900 PRINT "================ GAME OVER ================"
910 PRINT "YOUR EXPEDITION HAS PERISHED ON THE TRAIL!"
920 PRINT "===========================================": END
950 PRINT "EXPEDITION ABORTED.": END
