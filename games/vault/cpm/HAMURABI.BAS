10 REM ===================================================
20 REM HAMURABI - 1973 CLASSIC SUMERIAN EMPIRE SIMULATION
30 REM FOR CP/M MBASIC ON RUNCPM / RV32IM RETRO CONSOLE
40 REM ===================================================
50 PRINT "=================================================="
60 PRINT "HAMURABI: I BEG TO REPORT TO THEE,"
65 PRINT "IN YEAR 1 OF THY REIGN OVER ANCIENT SUMERIA."
70 P = 100: B = 2800: A = 1000: Y = 1: D = 0: S = 3
100 REM --- YEAR LOOP ---
110 PRINT "--------------------------------------------------"
120 PRINT "O HAMURABI, IN YEAR "; Y; ":"
130 PRINT "POPULATION IS NOW:        "; P; " PEOPLE"
140 PRINT "THE CITY OWNS:            "; A; " ACRES OF LAND"
150 PRINT "HARVEST YIELDED:          "; S; " BUSHELS PER ACRE"
160 PRINT "RATS DESTROYED:           "; D; " BUSHELS"
170 PRINT "GRAIN IN STORAGE:         "; B; " BUSHELS"
180 PRICE = INT(RND(1)*6) + 17
190 PRINT "LAND TRADING PRICE:       "; PRICE; " BUSHELS PER ACRE"
200 PRINT "--------------------------------------------------"
210 REM --- BUY/SELL LAND ---
220 INPUT "HOW MANY ACRES DO YOU WISH TO BUY"; BUY
230 IF BUY < 0 THEN PRINT "HAMURABI, THINK AGAIN!": GOTO 220
240 IF BUY * PRICE > B THEN PRINT "HAMURABI, THOU HAST NOT ENOUGH GRAIN!": GOTO 220
250 IF BUY > 0 THEN A = A + BUY: B = B - BUY * PRICE: GOTO 300
260 INPUT "HOW MANY ACRES DO YOU WISH TO SELL"; SELL
270 IF SELL < 0 THEN PRINT "HAMURABI, THINK AGAIN!": GOTO 260
280 IF SELL > A THEN PRINT "THOU DOST NOT OWN THAT MUCH LAND!": GOTO 260
290 A = A - SELL: B = B + SELL * PRICE
300 REM --- FEED POPULATION ---
310 PRINT: PRINT "GRAIN REMAINING: "; B; " BUSHELS."
320 INPUT "HOW MANY BUSHELS DO YOU WISH TO FEED YOUR PEOPLE"; FEED
330 IF FEED < 0 OR FEED > B THEN PRINT "THOU DOST NOT HAVE THAT MUCH GRAIN!": GOTO 320
340 B = B - FEED
350 REM --- PLANT CROPS ---
360 INPUT "HOW MANY ACRES DO YOU WISH TO PLANT WITH SEED"; PLANT
370 IF PLANT < 0 OR PLANT > A THEN PRINT "THOU HAST NOT ENOUGH LAND!": GOTO 360
380 IF PLANT / 2 > B THEN PRINT "THOU HAST NOT ENOUGH SEED GRAIN!": GOTO 360
390 IF PLANT > P * 10 THEN PRINT "NOT ENOUGH LABORERS TO TILL THE FIELDS!": GOTO 360
400 B = B - INT(PLANT / 2)
410 REM --- CALCULATE YEAR END RESULTS ---
420 S = INT(RND(1)*5) + 1
430 H = PLANT * S
440 E = 0
450 IF INT(RND(1)*5) = 1 THEN E = INT(B / (INT(RND(1)*4) + 1))
460 B = B - E + H
470 D = E
480 C = INT(FEED / 20)
490 IF C >= P THEN STARVED = 0: IMM = INT(RND(1)*((20*A+B)/P/100)+1): P = P + IMM: GOTO 550
500 STARVED = P - C
510 IF STARVED > 0.45 * P THEN PRINT "*** YOU STARVED "; STARVED; " PEOPLE IN ONE YEAR! ***": GOTO 900
520 P = C
550 Y = Y + 1
560 IF Y <= 10 GOTO 100
600 REM --- GAME WON ---
610 PRINT "=================================================="
620 PRINT "*** THOU HAST GOVERNED WISELY FOR 10 YEARS! ***"
630 PRINT "FINAL POPULATION: "; P; " | ACRES: "; A; " | GRAIN: "; B
640 PRINT "==================================================": END
900 REM --- GAME OVER / DEPOSED ---
910 PRINT "================ GAME OVER ================"
920 PRINT "DUE TO HORRIFIC FAMINE, THE SURVIVORS HAVE OVERTHROWN THEE!"
930 PRINT "THOU ART BANISHED FROM ANCIENT SUMERIA!"
940 PRINT "===========================================": END
