10 REM ===================================================
20 REM SUPER STAR TREK - CLASSIC RETRO CP/M EDITION (1978)
30 REM FOR MBASIC 5.29 ON RUNCPM / RV32IM FPGA CONSOLE
40 REM ===================================================
50 PRINT "=============================================="
60 PRINT "          *** SUPER STAR TREK ***             "
70 PRINT "      U.S.S. ENTERPRISE - NCC-1701            "
80 PRINT "==============================================": PRINT
90 G = 8: S = 3000: E = 3000: T = 10: K = 12: D = 30
100 QX = INT(RND(1)*8)+1: QY = INT(RND(1)*8)+1
110 SX = INT(RND(1)*8)+1: SY = INT(RND(1)*8)+1
120 KL = 3: ST = 4: B = 1
130 PRINT "STARDATE 3200. MISSION: DESTROY "; K; " KLINGONS IN "; D; " DAYS."
140 PRINT "CURRENT QUADRANT: ["; QX; ","; QY; "] SECTOR: ["; SX; ","; SY; "]"
150 PRINT: GOTO 300
200 REM --- COMMAND LOOP ---
210 PRINT: PRINT "COMMANDS: 1=SRS, 2=LRS, 3=PHASERS, 4=TORPEDO, 5=WARP, 6=SHIELDS, 7=STATUS, 8=RESIGN"
220 INPUT "COMMAND"; C
230 IF C = 1 GOTO 300
240 IF C = 2 GOTO 400
250 IF C = 3 GOTO 500
260 IF C = 4 GOTO 600
270 IF C = 5 GOTO 700
280 IF C = 6 GOTO 800
290 IF C = 7 GOTO 900
295 IF C = 8 GOTO 1000
298 PRINT "INVALID COMMAND.": GOTO 210
300 REM --- SHORT RANGE SENSORS ---
310 PRINT "----------------------------------------"
320 PRINT "SHORT RANGE SENSOR SCAN [QUADRANT "; QX; ","; QY; "]"
330 FOR Y = 1 TO 8
340   FOR X = 1 TO 8
350     IF X = SX AND Y = SY THEN PRINT "<E> ";: GOTO 380
360     IF X = 3 AND Y = 3 AND KL > 0 THEN PRINT "+K+ ";: GOTO 380
370     IF X = 6 AND Y = 2 AND KL > 1 THEN PRINT "+K+ ";: GOTO 380
375     IF X = 4 AND Y = 7 AND B = 1 THEN PRINT ">B< ";: GOTO 380
378     IF (X+Y) = 7 THEN PRINT " *  ";: GOTO 380
379     PRINT " .  ";
380   NEXT X
381   IF Y = 1 THEN PRINT "  STARDATE:  "; 3200 + (30 - D)
382   IF Y = 2 THEN PRINT "  CONDITION: ";: IF KL > 0 THEN PRINT "RED" ELSE PRINT "GREEN"
383   IF Y = 3 THEN PRINT "  QUADRANT:  "; QX; ","; QY
384   IF Y = 4 THEN PRINT "  SECTOR:    "; SX; ","; SY
385   IF Y = 5 THEN PRINT "  ENERGY:    "; E
386   IF Y = 6 THEN PRINT "  SHIELDS:   "; S
387   IF Y = 7 THEN PRINT "  TORPEDOES: "; T
388   IF Y = 8 THEN PRINT "  KLINGONS:  "; K
389 NEXT Y
390 PRINT "----------------------------------------": GOTO 200
400 REM --- LONG RANGE SENSORS ---
410 PRINT: PRINT "LONG RANGE SENSOR SCAN AROUND ["; QX; ","; QY; "]"
420 PRINT "+-----+-----+-----+"
430 PRINT "| "; KL; "0"; ST; " | 001 | 00"; ST; " |"
440 PRINT "+-----+-----+-----+"
450 PRINT "| 00"; B; " | <E> | 102 |"
460 PRINT "+-----+-----+-----+"
470 PRINT "| 003 | 000 | "; KL-1; "01 |"
480 PRINT "+-----+-----+-----+"
490 GOTO 200
500 REM --- PHASERS ---
510 IF KL <= 0 THEN PRINT "NO KLINGONS IN THIS QUADRANT!": GOTO 200
520 INPUT "UNITS OF ENERGY TO FIRE"; P
530 IF P <= 0 GOTO 200
540 IF P > E THEN PRINT "NOT ENOUGH ENERGY! CURRENT ENERGY: "; E: GOTO 520
550 E = E - P
560 HIT = INT((P / KL) * (INT(RND(1)*4)+1))
570 PRINT "PHASERS LOCKED! DELIVERED "; HIT; " UNITS OF ENERGY DAMAGE!"
580 IF HIT >= 300 THEN KL = KL - 1: K = K - 1: PRINT "*** DIRECT HIT! KLINGON SHIP DESTROYED! ***"
590 IF K <= 0 GOTO 1100
600 REM --- CHECK D ---
605 GOTO 200
610 REM --- TORPEDO ---
620 IF T <= 0 THEN PRINT "ALL PHOTON TORPEDOES EXPENDED!": GOTO 200
630 INPUT "COURSE (1-8)"; CR
640 T = T - 1
650 IF CR >= 2 AND CR <= 4 THEN KL = KL - 1: K = K - 1: PRINT "*** TORPEDO HIT! KLINGON VESSEL OBLITERATED! ***": GOTO 670
660 PRINT "TORPEDO MISSED TARGET INTO OPEN SPACE."
670 IF K <= 0 GOTO 1100
680 GOTO 200
700 REM --- WARP ---
710 INPUT "ENTER DESTINATION QUADRANT X (1-8)"; QX
720 INPUT "ENTER DESTINATION QUADRANT Y (1-8)"; QY
730 IF QX < 1 OR QX > 8 OR QY < 1 OR QY > 8 THEN PRINT "OUT OF BOUNDS NAVIGATION!": GOTO 710
740 D = D - 1: E = E - 200
750 KL = INT(RND(1)*3)
760 IF D <= 0 GOTO 1200
770 PRINT "WARP DRIVE ENGAGED. ARRIVED AT QUADRANT ["; QX; ","; QY; "]."
780 GOTO 300
800 REM --- SHIELDS ---
810 PRINT "CURRENT ENERGY: "; E; " | CURRENT SHIELDS: "; S
820 INPUT "AMOUNT TO TRANSFER (+ TO RAISE, - TO LOWER)"; XFER
830 IF XFER > 0 AND XFER > E THEN PRINT "NOT ENOUGH ENERGY!": GOTO 820
840 IF XFER < 0 AND ABS(XFER) > S THEN PRINT "CANNOT REMOVE THAT MUCH!": GOTO 820
850 E = E - XFER: S = S + XFER: GOTO 200
900 REM --- STATUS ---
910 PRINT "================ SYSTEM STATUS ================"
920 PRINT "STARDATE:          "; 3200 + (30 - D)
930 PRINT "TIME REMAINING:    "; D; " DAYS"
940 PRINT "KLINGONS LEFT:     "; K
950 PRINT "ENERGY:            "; E; " / 3000"
960 PRINT "SHIELDS:           "; S; " / 3000"
970 PRINT "PHOTON TORPEDOES:  "; T; " / 10"
980 PRINT "===============================================": GOTO 200
1000 PRINT "MISSION ABORTED. YOU RESIGNED FROM STARFLEET.": END
1100 PRINT "=============================================="
1110 PRINT "*** CONGRATULATIONS! THE GALAXY IS SAVED! ***"
1120 PRINT "YOU DESTROYED ALL KLINGON INVADERS!"
1130 PRINT "==============================================": END
1200 PRINT "================ GAME OVER ================"
1210 PRINT "TIME EXPIRED! STARFLEET HEADQUARTERS CONQUERED!"
1220 PRINT "===========================================": END
