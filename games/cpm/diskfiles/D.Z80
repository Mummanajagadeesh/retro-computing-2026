                db    0
                db    0
                db    0
                db    0
                db    0
                db    0
                db    0
                db    0
                db    0
                db    0
Stack:          dw 0                    ; ...
SopFlg:         db 0                    ; ...
CPMuser:        db 0                    ; ...
                db    0
                db    0
CPMversion:     db 0                    ; ...
MPMflag:        db    0                 ; ...
LZflag:         db 0                    ; ...
Order:          db    0                 ; ...
                end
