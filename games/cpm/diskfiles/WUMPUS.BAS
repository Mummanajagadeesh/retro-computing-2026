10 REM ===================================================
20 REM HUNT THE WUMPUS - 1973 GREGORY YOB RETRO CLASSIC
30 REM FOR CP/M MBASIC ON RUNCPM / RV32IM RETRO CONSOLE
40 REM ===================================================
50 PRINT "=============================================="
60 PRINT "            *** HUNT THE WUMPUS ***           "
70 PRINT "=============================================="
80 PRINT "YOU ARE IN A CAVE OF 20 ROOMS (DODECAHEDRON)."
90 PRINT "EACH ROOM CONNECTS TO 3 OTHER ROOMS."
100 PRINT "HAZARDS: 2 BOTTOMLESS PITS, 2 SUPER BATS, AND THE WUMPUS!"
110 PRINT "WEAPONS: 5 CROOKED MAGIC ARROWS."
120 PRINT "==============================================": PRINT
130 DIM C(20,3)
140 FOR I = 1 TO 20: READ C(I,1), C(I,2), C(I,3): NEXT I
150 DATA 2,5,8, 1,3,10, 2,4,12, 3,5,14, 1,4,6
160 DATA 5,7,15, 6,8,17, 1,7,9, 8,10,18, 2,9,11
170 DATA 10,12,19, 3,11,13, 12,14,20, 4,13,15, 6,14,16
180 DATA 15,17,20, 7,16,18, 9,17,19, 11,18,20, 13,16,19
190 L = 1: W = 15: P1 = 4: P2 = 12: B1 = 7: B2 = 18: A = 5
200 REM --- TURN LOOP ---
210 PRINT "--------------------------------------------------"
220 PRINT "YOU ARE IN ROOM "; L
230 FOR J = 1 TO 3
240   N = C(L, J)
250   IF N = W THEN PRINT ">> I SMELL A HORRIBLE WUMPUS! <<"
260   IF N = P1 OR N = P2 THEN PRINT ">> I FEEL A COLD DRAFT FROM A PIT! <<"
270   IF N = B1 OR N = B2 THEN PRINT ">> BATS NEARBY! FLAPPING WINGS HEARD! <<"
280 NEXT J
290 PRINT "TUNNELS LEAD TO ROOMS: "; C(L,1); ", "; C(L,2); ", "; C(L,3)
300 PRINT "MAGIC ARROWS REMAINING: "; A
310 INPUT "ACTION: (1=MOVE, 2=SHOOT, 3=QUIT)"; ACT
320 IF ACT = 1 GOTO 400
330 IF ACT = 2 GOTO 500
340 IF ACT = 3 GOTO 900
350 PRINT "INVALID ACTION!": GOTO 210
400 REM --- MOVE ---
410 INPUT "MOVE TO ROOM"; NR
420 IF NR <> C(L,1) AND NR <> C(L,2) AND NR <> C(L,3) THEN PRINT "NOT CONNECTED!": GOTO 410
430 L = NR
440 IF L = W THEN PRINT "*** TSK TSK... YOU WALKED INTO THE WUMPUS'S JAWS! ***": GOTO 950
450 IF L = P1 OR L = P2 THEN PRINT "*** YYYIIIIEEEE... FELL INTO A BOTTOMLESS PIT! ***": GOTO 950
460 IF L = B1 OR L = B2 THEN PRINT "*** ZAP! A SUPER BAT CARRIED YOU TO A RANDOM ROOM! ***": L = INT(RND(1)*20)+1: GOTO 440
470 GOTO 200
500 REM --- SHOOT ---
510 IF A <= 0 THEN PRINT "YOU ARE OUT OF ARROWS!": GOTO 200
520 A = A - 1
530 INPUT "SHOOT ARROW INTO ROOM"; TR
540 IF TR <> C(L,1) AND TR <> C(L,2) AND TR <> C(L,3) THEN PRINT "ARROW HIT THE WALL AND DUDDED!": GOTO 580
550 IF TR = W THEN PRINT "*** AHA! THE ARROW PIERCED THE WUMPUS! YOU WIN! ***": END
560 IF TR = L THEN PRINT "*** OUCH! THE ARROW RICOCHETED AND STRUCK YOU! ***": GOTO 950
570 PRINT "THE ARROW FLEW INTO THE DARKNESS..."
580 REM WUMPUS MAY AWAKEN
590 IF RND(1) < 0.75 THEN W = C(W, INT(RND(1)*3)+1): PRINT "A DEEP ROAR ECHOES! THE WUMPUS HAS MOVED!"
600 IF W = L THEN PRINT "*** THE SLEEPING WUMPUS AWOKE AND GOBBLED YOU UP! ***": GOTO 950
610 IF A = 0 THEN PRINT "YOU HAVE USED YOUR LAST ARROW! UNARMED AND DEFEATED!": GOTO 950
620 GOTO 200
900 PRINT "YOU HAVE RETREATED FROM THE CAVES.": END
950 PRINT "================ GAME OVER ================": END
